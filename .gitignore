# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Flutter app moved under /flutter
/flutter/.dart_tool/
/flutter/.flutter-plugins
/flutter/.flutter-plugins-dependencies
/flutter/.pub-cache/
/flutter/.pub/
/flutter/.packages
/flutter/build/
/flutter/android/.gradle/
/flutter/android/app/debug
/flutter/android/app/profile
/flutter/android/app/release
/flutter/android/local.properties
/flutter/android/key.properties
/flutter/android/release.properties
/flutter/android/*.jks
/flutter/ios/Flutter/AdMob.xcconfig
/flutter/ios/Pods/
/flutter/ios/.symlinks/
/flutter/macos/Flutter/ephemeral/
/flutter/windows/flutter/ephemeral/
/flutter/linux/flutter/ephemeral/

# Web tooling and browser-test artifacts (web/ source files stay versioned)
/.playwright-cli/
/web/node_modules/
/web/playwright-report/
/web/test-results/
/web/coverage/
/web/.cache/
/web/npm-debug.log*
/web/yarn-debug.log*
/web/yarn-error.log*

# Release credentials and platform identifiers
/android/key.properties
/ios/Flutter/AdMob.xcconfig
